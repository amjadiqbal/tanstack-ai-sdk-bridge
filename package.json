{
  "name": "@amjadiqbal/tanstack-ai-sdk-bridge",
  "version": "0.1.1",
  "description": "Use any Vercel AI SDK provider (@ai-sdk/* and community providers) as a TanStack AI adapter: streaming chat with tools, reasoning and structured output, plus embeddings, transcription, speech, image generation and rerank. Supports AI SDK provider spec v2, v3 and v4.",
  "keywords": [
    "tanstack",
    "tanstack-ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "ai-adapter",
    "llm",
    "deepseek",
    "cerebras",
    "togetherai",
    "fireworks",
    "embeddings",
    "tool-calling",
    "migration"
  ],
  "homepage": "https://github.com/amjadiqbal/tanstack-ai-sdk-bridge#readme",
  "bugs": "https://github.com/amjadiqbal/tanstack-ai-sdk-bridge/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amjadiqbal/tanstack-ai-sdk-bridge.git"
  },
  "license": "MIT",
  "author": {
    "name": "Amjad Iqbal",
    "url": "https://amjad.com.pk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --typecheck"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.32"
  },
  "peerDependencies": {
    "@tanstack/ai": "^1.0.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.86",
    "@ai-sdk/cerebras": "3.0.76",
    "@ai-sdk/cohere": "4.0.67",
    "@ai-sdk/deepseek": "3.0.71",
    "@ai-sdk/fireworks": "3.0.79",
    "@ai-sdk/openai": "4.0.100",
    "@ai-sdk/openai-compatible": "3.0.76",
    "@ai-sdk/openai-compatible-v2": "npm:@ai-sdk/openai-compatible@^1",
    "@ai-sdk/openai-compatible-v3": "npm:@ai-sdk/openai-compatible@^2",
    "@ai-sdk/togetherai": "3.0.77",
    "@biomejs/biome": "2.6.2",
    "@copilotkit/aimock": "1.46.0",
    "@tanstack/ai": "1.0.0",
    "@types/node": "^22.10.0",
    "ai": "7.0.149",
    "ollama-ai-provider-v2": "4.1.0",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "^4.1.8"
  }
}
